PORT=3000
HOST=0.0.0.0
# Path to tectonic binary (defaults to ./bin/tectonic.exe or system tectonic)
# TECTONIC_PATH=./bin/tectonic.exe
# Temporary working directory for compilation
# TEMP_DIR=./temp
# Timeout per compilation in milliseconds (default: 30000ms / 30s)
# COMPILATION_TIMEOUT_MS=30000
# Max upload size in bytes (default: 10MB)
# MAX_UPLOAD_SIZE_BYTES=10485760
